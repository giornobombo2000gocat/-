# Scopa Bot Configuration

# Website
TARGET_URL=https://www.betsson.it/it

# Bot Credentials
BOT_USERNAME=your_username
BOT_PASSWORD=your_password

# Room/Table
BOT_ROOM=your_room_name

# Debug Mode
DEBUG=true

# Proxy (optional)
USE_PROXY=false
PROXY_SERVER=http://proxy-server:port
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
